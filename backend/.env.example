# Copy this file to .env and fill in the three keys below.

# 1. LLM (free): https://console.groq.com -> API Keys
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-120b

# 2. Embeddings (free): https://jina.ai/embeddings -> Get API key
EMBED_BACKEND=jina
JINA_API_KEY=jina_your_key_here

# 3. Auth: any long random string (e.g. run: openssl rand -hex 32)
JWT_SECRET=replace-with-a-long-random-string

# Leave these as they are
CHROMA_DIR=../data/chroma_db
RAW_DIR=../data/raw
